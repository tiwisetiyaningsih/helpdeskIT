# --- Database (MySQL) ---
# Format: mysql://<user>:<password>@<host>:<port>/<nama_database>
# Kalau menjalankan lewat "podman compose up mysql",
# host & port di bawah ini sudah sesuai default compose.yml.
DATABASE_URL="mysql://root:password@localhost:3307/helpdesk"

# --- JWT (untuk access token & refresh token) ---
# WAJIB diganti dengan string acak,
# Bisa generate string acak lewat: openssl rand -hex 32
JWT_SECRET="ganti-dengan-secret-acak-milikmu"

# --- Redis (cache) ---
REDIS_HOST=localhost
REDIS_PORT=6380

# --- MinIO (object storage, untuk file evidence/lampiran tiket) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=password
MINIO_BUCKET=helpdesk
